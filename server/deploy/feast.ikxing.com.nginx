# 麦麦拼单 feast-sync — realtime rooms API (SSE). Source: github.com/Jasonin2099/mcd-team-feast/server
# Behind a CDN with TLS; backend listens on 127.0.0.1 only.
server { listen 80; listen [::]:80; server_name feast.ikxing.com; return 301 https://$host$request_uri; }
server {
    listen 443 ssl http2; listen [::]:443 ssl http2;
    server_name feast.ikxing.com;
    ssl_certificate     /etc/nginx/ssl/feast.ikxing.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/feast.ikxing.com/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 16k;
    location = /robots.txt { default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
    location ~ ^/rooms/[A-Za-z0-9_-]{8}/events$ {
        proxy_pass http://127.0.0.1:8787; proxy_http_version 1.1; proxy_set_header Connection "";
        proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr;
        proxy_buffering off; proxy_cache off; proxy_read_timeout 1h; chunked_transfer_encoding on;
    }
    location / { proxy_pass http://127.0.0.1:8787; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_read_timeout 15s; }
}
