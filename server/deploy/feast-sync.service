[Unit]
Description=feast-sync realtime rooms (SSE)
After=network.target

[Service]
User=www-data
Group=www-data
Environment=PORT=8787 HOST=127.0.0.1 DATA=/var/lib/feast-sync/rooms.json ORIGINS=https://jasonin2099.github.io
ExecStart=/usr/bin/node /srv/feast-sync/sync-server.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/feast-sync
MemoryMax=256M

[Install]
WantedBy=multi-user.target
